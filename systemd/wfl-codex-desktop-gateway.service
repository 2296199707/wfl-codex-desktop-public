[Unit]
Description=WFL Codex Desktop stable gateway
Wants=network-online.target
After=network-online.target
Conflicts=wfl-codex-desktop.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/srv/wfl-codex-desktop
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=CODEX_DESKTOP_UPSTREAM_PORTS=4318,4319
Environment=CODEX_DESKTOP_UPSTREAM_PORT=4318
Environment=CODEX_DESKTOP_ACTIVE_PORT_FILE=/srv/wfl-codex-desktop/.codex-runtime/active-port
Environment=CODEX_DESKTOP_RESCUE_PORT=4321
ExecStart=/usr/bin/node /srv/wfl-codex-desktop/gateway.mjs
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
