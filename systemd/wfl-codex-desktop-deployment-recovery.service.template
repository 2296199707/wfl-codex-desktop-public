[Unit]
Description=WFL Codex Desktop interrupted deployment recovery
Wants=network-online.target wfl-codex-desktop-gateway.service
After=local-fs.target network-online.target wfl-codex-desktop-gateway.service
StartLimitIntervalSec=120s
StartLimitBurst=45

[Service]
Type=oneshot
TimeoutStartSec=45s
User=root
WorkingDirectory={{SOURCE_DIR}}
Environment=HOME={{SERVICE_HOME}}
Environment=PATH={{SERVICE_PATH}}
Environment=PLAYWRIGHT_BROWSERS_PATH={{PLAYWRIGHT_BROWSERS_PATH}}
Environment=CODEX_DESKTOP_SOURCE_DIR={{SOURCE_DIR}}
Environment=CODEX_DESKTOP_STATE_DIR={{STATE_DIR}}
Environment=CODEX_DESKTOP_RUNTIME_DIR={{RUNTIME_DIR}}
ExecStart={{NODE_BIN}} {{SOURCE_DIR}}/scripts/recover-interrupted-deployment.mjs

[Install]
WantedBy=multi-user.target
