#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
APP_DIR="$(dirname -- "$SCRIPT_DIR")"
RUNTIME_DIR="${CODEX_DESKTOP_RUNTIME_DIR:-$APP_DIR/.codex-runtime}"
MANAGED_COMMAND="$RUNTIME_DIR/claude/current/claude"
BUNDLED_COMMAND="$APP_DIR/node_modules/.bin/claude"

if [[ -x "$MANAGED_COMMAND" ]]; then
  exec "$MANAGED_COMMAND" "$@"
fi
if [[ -x "$BUNDLED_COMMAND" ]]; then
  exec "$BUNDLED_COMMAND" "$@"
fi

printf 'Claude Code is not installed. Install it from the WFL Codex Desktop version center.\n' >&2
exit 127
